{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ccjtkalamazoo.org/kyr/schema/chapter.schema.json",
  "title": "Know Your Rights chapter",
  "description": "One chapter: 30 questions. See docs/CONTENT.md for the authoring rules behind these constraints.",
  "type": "object",
  "required": [
    "chapterId",
    "districtId",
    "name",
    "questions"
  ],
  "additionalProperties": false,
  "properties": {
    "chapterId": {
      "type": "string",
      "pattern": "^[a-z]+\\.[0-9]{2}$",
      "description": "district slug + zero-padded chapter number, e.g. stop.03"
    },
    "districtId": {
      "type": "string",
      "pattern": "^[a-z]+$"
    },
    "name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 40,
      "description": "Display name, e.g. AM I FREE TO GO"
    },
    "reviewedBy": {
      "type": [
        "string",
        "null"
      ],
      "description": "Attorney who cleared this chapter. Null until reviewed. A chapter cannot ship with this null."
    },
    "reviewedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date",
      "description": "YYYY-MM-DD"
    },
    "questions": {
      "type": "array",
      "minItems": 30,
      "maxItems": 30,
      "description": "Exactly 30. The game deals 15 at random.",
      "items": {
        "$ref": "#/$defs/question"
      }
    }
  },
  "$defs": {
    "question": {
      "type": "object",
      "required": [
        "id",
        "version",
        "q",
        "options",
        "hint",
        "principle",
        "keyPhrase",
        "scenario"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z]+\\.[0-9]{2}\\.[0-9]{3}$",
          "description": "Permanent. Never reused, even after retirement. e.g. stop.03.007"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "description": "Increment on any edit to question or option text."
        },
        "q": {
          "type": "string",
          "minLength": 10,
          "maxLength": 220,
          "not": {
            "pattern": "\\u2014"
          },
          "description": "The question. No em dashes."
        },
        "options": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "description": "Exactly four. Index 0 is ALWAYS the correct answer; the game shuffles display order.",
          "items": {
            "$ref": "#/$defs/option"
          }
        },
        "hint": {
          "type": "string",
          "minLength": 10,
          "maxLength": 260,
          "not": {
            "pattern": "\\u2014"
          },
          "description": "What COUNSEL shows. Points at the reasoning, not the answer."
        },
        "principle": {
          "type": "string",
          "minLength": 40,
          "maxLength": 700,
          "not": {
            "pattern": "\\u2014"
          },
          "description": "The law in plain language. Lead with the rule, then the case."
        },
        "safetyNote": {
          "type": "string",
          "minLength": 40,
          "maxLength": 400,
          "not": {
            "pattern": "\\u2014"
          },
          "description": "Optional. Safety framing shown under the law on card 1, styled as a warning rather than law. Use where knowing a right and safely using it can come apart: getting home safe outranks winning the moment."
        },
        "keyPhrase": {
          "type": "object",
          "required": [
            "quote",
            "gloss"
          ],
          "additionalProperties": false,
          "properties": {
            "quote": {
              "type": "string",
              "minLength": 4,
              "maxLength": 120,
              "not": {
                "pattern": "\\u2014"
              },
              "description": "The words to say out loud. Short enough to recall under stress."
            },
            "gloss": {
              "type": "string",
              "minLength": 4,
              "maxLength": 160,
              "not": {
                "pattern": "\\u2014"
              }
            }
          }
        },
        "scenario": {
          "type": "object",
          "required": [
            "setup"
          ],
          "additionalProperties": true,
          "properties": {
            "setup": {
              "type": "string",
              "minLength": 15,
              "not": {
                "pattern": "\\u2014"
              },
              "description": "A concrete situation. Specific beats abstract."
            }
          }
        },
        "retired": {
          "type": "boolean",
          "default": false,
          "description": "Retired questions keep their ID forever so analytics stay interpretable."
        }
      }
    },
    "option": {
      "type": "object",
      "required": [
        "id",
        "text",
        "isCorrect"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z]+\\.[0-9]{2}\\.[0-9]{3}\\.[a-d]$",
          "description": "Question id + a-d. Assigned at authoring time and never moved; display order is shuffled at runtime, so position is meaningless for analytics."
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180,
          "not": {
            "pattern": "\\u2014"
          }
        },
        "isCorrect": {
          "type": "boolean"
        },
        "explanation": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 500,
          "description": "Null for the correct option, required for every wrong one. This is where most of the teaching happens."
        },
        "misconceptionCode": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z][a-z0-9_]*$",
          "description": "Names the false belief this distractor tests. Null for the correct option, required for every wrong one. Must exist in misconceptions.json."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "isCorrect": {
                "const": false
              }
            }
          },
          "then": {
            "required": [
              "explanation",
              "misconceptionCode"
            ],
            "properties": {
              "explanation": {
                "type": "string",
                "minLength": 15
              },
              "misconceptionCode": {
                "type": "string",
                "minLength": 3
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "isCorrect": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "explanation": {
                "type": "null"
              },
              "misconceptionCode": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  }
}
