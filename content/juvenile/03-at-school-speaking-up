      "version": 1,
      "q": "You heard something that worries you about a classmate, but you are not certain it is real. What should you do?",
      "options": [
        {
          "id": "juvenile.03.003.a",
          "text": "Report what you heard, and say plainly which part you are unsure about.",
          "isCorrect": true,
          "explanation": null,
          "misconceptionCode": null
        },
        {
          "id": "juvenile.03.003.b",
          "text": "Wait until you know for sure, so you do not waste anybody's time.",
          "isCorrect": false,
          "explanation": "Nobody expects you to be sure. Waiting for certainty is how things get missed.",
          "misconceptionCode": "must_be_sure_to_report"
        },
        {
          "id": "juvenile.03.003.c",
          "text": "Ask around first to find out whether it is even true.",
          "isCorrect": false,
          "explanation": "Asking around warns people and spreads something that may not be true. It is the one move that makes it worse.",
          "misconceptionCode": "check_it_yourself_first"
