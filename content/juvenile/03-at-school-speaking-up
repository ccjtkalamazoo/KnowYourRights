  "reviewedAt": null,
  "questions": [
    {
      "id": "juvenile.03.001",
      "version": 1,
      "q": "You send a tip to OK2SAY, Michigan's school safety line. What happens to it first?",
      "options": [
        {
          "id": "juvenile.03.001.a",
          "text": "It goes to a trained person at the state police, who decides where to send it.",
          "isCorrect": true,
          "explanation": null,
          "misconceptionCode": null
        },
        {
          "id": "juvenile.03.001.b",
          "text": "It goes straight to your principal with your name attached.",
          "isCorrect": false,
          "explanation": "Tips reach the state police first, and your name is not attached when they pass one on.",
          "misconceptionCode": "tips_are_traced_back"
        },
        {
          "id": "juvenile.03.001.c",
          "text": "It sits there until you confirm who you are.",
          "isCorrect": false,
          "explanation": "You never have to give a name. You do leave a phone number or email so they can ask you questions.",
          "misconceptionCode": "a_tip_needs_your_name"
        },
        {
          "id": "juvenile.03.001.d",
          "text": "It comes back to you with an answer about what they will do.",
          "isCorrect": false,
          "explanation": "You get a note saying it arrived. What happens after that is not something you get told.",
          "misconceptionCode": "reporting_gets_me_an_update"
        }
      ],
      "hint": "Who reads it before the school does?",
      "principle": "OK2SAY is Michigan's student safety tip line. The state police run it, and anybody can use it, day or night. A trained person reads what you send, asks you questions if they need more, and decides who should get it. That might be your school, local police, or a mental health agency. Life threats and crimes happening now go to police first. Everything else usually reaches a school administrator the next school day.",
      "keyPhrase": {
        "quote": "A person reads it, not a machine.",
        "gloss": "Trained state police staff sort every tip."
      },
      "scenario": {
        "setup": "Your kitchen table, late. The app is open on your phone.",
        "lines": [
          {
            "label": "FRIEND",
            "text": "Are you actually going to send that?"
          },
          {
            "label": "YOU",
            "text": "I think so. I don't even know who reads these."
          },
          {
            "label": "FRIEND",
            "text": "Some office somewhere."
          },
          {
            "label": "YOU",
            "text": "State police, apparently. I'm sending it."
          },
          {
            "label": "YES",
            "text": "It gets read tonight by somebody whose job is reading them."
          },
          {
            "label": "NO",
            "text": "The thing you know stays with only you, and nobody else can act on it."
          }
        ],
        "note": "If somebody is in danger right now, that is a 911 call, not a tip."
      }
    },
